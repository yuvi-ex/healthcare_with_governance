# Settings for the access-on-request demo. Every value can also be overridden by an environment variable of the same name.
# Read by hcconfig.py (Python) and setup/common.sh (shell). Paths are relative to this repository unless absolute.

# The hospital-chain build this demo sits on (github.com/yuvi-ex/hospital_chain): its HOSP_* objects must exist in Exasol.
# The S3 bucket, region, prefix and the read-only S3 key are read from ITS config.env, so both always agree.
HC_BASE_DIR=../hospital_chain

# Exasol (Exasol Personal on this machine)
HC_EXA_HOST=127.0.0.1
HC_EXA_PORT=8563
# the admin profile in ~/.exapump/config.toml used by the set-up scripts
HC_EXAPUMP_PROFILE=starter-kit

# The access-desk service (loopback only) and the console on dash-server
HC_GOV_SERVICE_PORT=8518
HC_GOV_APP=health-access
HC_DASH_PORT=5100
HC_DASH_PROFILE=starter-kit

# "Ask your own question": Claude writes the query. Put ANTHROPIC_API_KEY=... in this file (mode 600, git-ignored).
# Without it everything else works; typed questions say Claude is not available.
HC_ANTHROPIC_KEY_FILE=secrets/anthropic.env
HC_CLAUDE_MODEL=claude-sonnet-5-5
